# Copy this file to .env and fill it in. .env is gitignored: never commit a real key.
# Concord reads it on start, so restart the server after changing it.
# A variable already set in your shell wins over the value here.

# Lets Concord answer free-form questions by having Gemini write the SQL.
# Create a key at https://aistudio.google.com/apikey
# Leave it empty to answer from the reviewed questions only.
GEMINI_API_KEY=

# Optional: the Gemini model that writes the SQL. Default: gemini-3.8-flash
# CONCORD_MODEL=gemini-3.8-flash
