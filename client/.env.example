# Copy this file to .env and fill it in. The client reads it when it starts, so restart the client after changing it.
# A variable already set in your shell wins over the value here.

# The address of the Concord server this client connects to. Default: http://127.0.0.1:8040 (a server on this computer).
# For a server on another computer, use the address it prints when it starts, for example:
# CONCORD_SERVER=http://192.168.1.20:8040
CONCORD_SERVER=
